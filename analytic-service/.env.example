# Service
PORT=8000

# Kafka (local Docker stack advertises EXTERNAL as localhost:9092)
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC=ais.raw.messages
KAFKA_GROUP_ID=analytic-speed-anomalies
KAFKA_AUTO_OFFSET_RESET=earliest

# Meta-service (anomalies are POSTed here; token must be a valid JWT for a user)
META_SERVICE_URL=http://localhost:5000
META_SERVICE_TOKEN=YOUR_JWT_TOKEN

# Anomaly detection tuning
ANOMALY_CONTAMINATION=0.05
ANOMALY_N_ESTIMATORS=100
ANOMALY_WINDOW_SIZE=50
ANOMALY_MIN_SAMPLES=10
ANOMALY_HTTP_TIMEOUT=10
