# Service
PORT=8000

# Kafka (local Docker stack advertises EXTERNAL as localhost:9092)
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC=ais.raw.messages
KAFKA_GROUP_ID=analytic-speed-anomalies
KAFKA_AUTO_OFFSET_RESET=earliest

# Meta-service: anomalies are POSTed here and detector settings are read from it.
# Use the service account from `cd meta-service && npm run service-account`; the client logs
# in again on 401 and every 12 h. META_SERVICE_TOKEN (a fixed JWT) only suits quick tests.
META_SERVICE_URL=http://localhost:5000
META_SERVICE_EMAIL=analytic-service@serenguard.local
META_SERVICE_PASSWORD=
# META_SERVICE_TOKEN=
ANOMALY_HTTP_TIMEOUT=10
# How often detector settings are re-read from meta-service (seconds)
SETTINGS_POLL_S=60

# Speed model. Thresholds, score cut-offs, refit interval and loitering rules are admin
# settings in meta-service (Detection settings page), not env vars.
ANOMALY_N_ESTIMATORS=100
# Recent positions kept for refitting, and the minimum before the first refit
SPEED_TRAIN_WINDOW=50000
SPEED_MIN_TRAIN_SAMPLES=2000
# Saved model (default models/speed_model.joblib) and the CSV used when there is none
# (default ../AI/ais_dataset.csv; set empty to skip bootstrapping)
# SPEED_MODEL_PATH=
# SPEED_TRAINING_CSV=
