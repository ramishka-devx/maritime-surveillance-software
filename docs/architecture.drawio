<mxfile host="drawio"><diagram id="c4-l3" name="C4 L3 – Components"><mxGraphModel adaptiveColors="auto" grid="1" gridSize="10" page="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="v1" value="SerenGuard — C4 Level 3: Component diagram&lt;br&gt;&lt;font style='font-size:13px;font-weight:normal'&gt;Components inside each container of the maritime surveillance platform&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=20;fontStyle=1;fontColor=#0F172A;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1130" y="40" width="700" height="60" as="geometry"/></mxCell><mxCell id="v2" value="&lt;b&gt;Operator / Analyst&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;[Person]&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Watches the map, triages alerts, manages zones and users&lt;/font&gt;" style="shape=mxgraph.c4.person2;whiteSpace=wrap;html=1;align=center;fillColor=#08427B;strokeColor=#073B6F;fontColor=#FFFFFF;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="870" y="10" width="220" height="180" as="geometry"/></mxCell><mxCell id="v3" value="&lt;b&gt;aisstream.io&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;[External system]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Global AIS feed over WebSocket&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#8A8A8A;fontColor=#FFFFFF;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="60" y="40" width="210" height="100" as="geometry"/></mxCell><mxCell id="v4" value="&lt;b&gt;web&lt;/b&gt; [Container: React 19 · Vite · Leaflet]" style="rounded=1;arcSize=2;html=1;whiteSpace=wrap;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=#666666;fontColor=#333333;fontSize=14;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;pointerEvents=0;connectable=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="600" y="210" width="1260" height="180" as="geometry"/></mxCell><mxCell id="v5" value="&lt;b&gt;Auth&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;[AuthContext · ProtectedRoute]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;JWT, user, roles; route guards&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#0B2545;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="630" y="250" width="210" height="100" as="geometry"/></mxCell><mxCell id="v6" value="&lt;b&gt;Operator Pages&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;[React pages]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Alerts, zones, users/RBAC, settings, reports&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#0B2545;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="870" y="250" width="210" height="100" as="geometry"/></mxCell><mxCell id="v7" value="&lt;b&gt;API Client&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;[lib/api.js]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Adds JWT, unwraps {success, data}&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#0B2545;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1110" y="250" width="210" height="100" as="geometry"/></mxCell><mxCell id="v8" value="&lt;b&gt;VesselContext&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;[useVesselUpdates]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Polls latest positions every 8 s (bbox)&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#0B2545;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1350" y="250" width="210" height="100" as="geometry"/></mxCell><mxCell id="v9" value="&lt;b&gt;Map View&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;[MapCanvas · canvas layer]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Draws vessels on one Leaflet canvas&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#0B2545;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1590" y="250" width="210" height="100" as="geometry"/></mxCell><mxCell id="v10" value="&lt;b&gt;meta-service&lt;/b&gt; [Container: Node.js · Express]" style="rounded=1;arcSize=2;html=1;whiteSpace=wrap;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=#666666;fontColor=#333333;fontSize=14;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;pointerEvents=0;connectable=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="600" y="460" width="1260" height="480" as="geometry"/></mxCell><mxCell id="v11" value="&lt;b&gt;Scheduled Detectors&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;[node-cron]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Geofence 30 s · dark vessel 5 min · STS 1 min&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#0B2545;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="630" y="500" width="210" height="100" as="geometry"/></mxCell><mxCell id="v12" value="&lt;b&gt;Partition Cron&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;[partition-cron.js]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;ais_positions partitions, 2-day retention&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#0B2545;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="870" y="500" width="210" height="100" as="geometry"/></mxCell><mxCell id="v13" value="&lt;b&gt;Incursion Socket&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;[ws · pg LISTEN]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Pushes geofence incursions to the UI&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#0B2545;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1350" y="500" width="210" height="100" as="geometry"/></mxCell><mxCell id="v14" value="&lt;b&gt;Router + middleware&lt;/b&gt;  [Express]   auth → permission → activityLogger → validate → controller" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#C5DDF5;strokeColor=#5D82A8;fontColor=#0B2545;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="630" y="630" width="1170" height="50" as="geometry"/></mxCell><mxCell id="v15" value="&lt;b&gt;Users &amp;amp; RBAC&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;[users · roles · permissions · activities]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Login (JWT), roles, audit log&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#0B2545;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="630" y="720" width="210" height="100" as="geometry"/></mxCell><mxCell id="v16" value="&lt;b&gt;AIS &amp;amp; Vessels&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;[ais · vessels · positions]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Latest positions, search, tracks&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#0B2545;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="870" y="720" width="210" height="100" as="geometry"/></mxCell><mxCell id="v17" value="&lt;b&gt;Alerts &amp;amp; Anomalies&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;[alerts · anomalies · notifications]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Anomaly → alert, cooldown, triage&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#0B2545;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1110" y="720" width="210" height="100" as="geometry"/></mxCell><mxCell id="v18" value="&lt;b&gt;Zones &amp;amp; Detection Settings&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;[restricted-areas · detection-settings]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Geofences, thresholds&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#0B2545;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1350" y="720" width="210" height="100" as="geometry"/></mxCell><mxCell id="v19" value="&lt;b&gt;Dashboard &amp;amp; Reports&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;[dashboard · reports]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;KPIs and exports&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#0B2545;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1590" y="720" width="210" height="100" as="geometry"/></mxCell><mxCell id="v20" value="&lt;b&gt;DB shim&lt;/b&gt;  [db.config.js · pg Pool]   MySQL-style SQL → Postgres ($n params, RETURNING)" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#C5DDF5;strokeColor=#5D82A8;fontColor=#0B2545;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="630" y="860" width="1170" height="50" as="geometry"/></mxCell><mxCell id="v21" value="&lt;b&gt;ais_db&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;[Container: PostgreSQL + PostGIS]&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;ships, ais_positions (partitioned), alerts, anomalies, RBAC&lt;/font&gt;" style="shape=cylinder3;size=12;boundedLbl=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1110" y="1000" width="230" height="130" as="geometry"/></mxCell><mxCell id="v22" value="&lt;b&gt;ingest-service&lt;/b&gt; [Container: Node.js]" style="rounded=1;arcSize=2;html=1;whiteSpace=wrap;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=#666666;fontColor=#333333;fontSize=14;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;pointerEvents=0;connectable=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="200" width="480" height="380" as="geometry"/></mxCell><mxCell id="v23" value="&lt;b&gt;AIS Stream Client&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;[index.js · ws]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Subscribes, heartbeat, reconnect&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#0B2545;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="60" y="250" width="210" height="100" as="geometry"/></mxCell><mxCell id="v24" value="&lt;b&gt;AIS Parser&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;[parser.js]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;PositionReport / ShipStaticData → row&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#0B2545;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="290" y="250" width="210" height="100" as="geometry"/></mxCell><mxCell id="v25" value="&lt;b&gt;Kafka Gateway&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;[kafka.js · kafkajs]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Producer, consumer, topic admin&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#0B2545;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="60" y="440" width="210" height="100" as="geometry"/></mxCell><mxCell id="v26" value="&lt;b&gt;Persistence Writer&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;[insert.js]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Ships, positions, geofence state, NOTIFY&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#0B2545;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="290" y="440" width="210" height="100" as="geometry"/></mxCell><mxCell id="v27" value="&lt;b&gt;Kafka&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;[Container: Apache Kafka]&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;topic ais.raw.messages&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="60" y="630" width="210" height="90" as="geometry"/></mxCell><mxCell id="v28" value="&lt;b&gt;analytic-service&lt;/b&gt; [Container: Python · FastAPI]" style="rounded=1;arcSize=2;html=1;whiteSpace=wrap;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=#666666;fontColor=#333333;fontSize=14;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;pointerEvents=0;connectable=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="780" width="480" height="450" as="geometry"/></mxCell><mxCell id="v29" value="&lt;b&gt;Speed Anomaly Consumer&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;[kafka_consumer.py]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Polls topic, parses, dispatches&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#0B2545;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="60" y="830" width="210" height="100" as="geometry"/></mxCell><mxCell id="v30" value="&lt;b&gt;Speed Model&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;[speed_model.py · scikit-learn]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;p99 gate + IsolationForest, refit&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#0B2545;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="290" y="830" width="210" height="100" as="geometry"/></mxCell><mxCell id="v31" value="&lt;b&gt;Detection API&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;[routes.py · FastAPI]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Stats, batch CSV speed check&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#0B2545;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="60" y="960" width="210" height="100" as="geometry"/></mxCell><mxCell id="v32" value="&lt;b&gt;Loitering Detector&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;[loitering.py]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Rule-based dwell check&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#0B2545;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="290" y="960" width="210" height="100" as="geometry"/></mxCell><mxCell id="v33" value="&lt;b&gt;Settings Store&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;[settings.py]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Polls thresholds every SETTINGS_POLL_S&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#0B2545;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="60" y="1090" width="210" height="100" as="geometry"/></mxCell><mxCell id="v34" value="&lt;b&gt;Meta Client&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;[meta_client.py · httpx]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Service login, re-auth, POST anomalies&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#0B2545;fontSize=13;fontFamily=