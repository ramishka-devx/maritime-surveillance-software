        <mxCell id="e57" value="no (direct write)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="d2" target="q1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="255" y="790" /></Array></mxGeometry></mxCell>
