<mxfile host="app.diagrams.net">
  <diagram id="ingest-flow" name="Ingestion flow">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2350" pageHeight="1300" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;b&gt;ingest-service: AIS ingestion flow&lt;/b&gt;&lt;br&gt;aisstream.io → (Kafka) → parse → PostgreSQL/PostGIS (ais_db)" style="text;html=1;align=left;verticalAlign=top;fontSize=16;" vertex="1" parent="1"><mxGeometry x="20" y="0" width="900" height="50" as="geometry" /></mxCell>
        <mxCell id="L1" value="1. Startup &amp; AIS stream (index.js)" style="swimlane;startSize=30;html=1;fontStyle=1;fontSize=14;fillColor=#f9f9f9;strokeColor=#999999;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="20" y="60" width="600" height="1200" as="geometry" /></mxCell>
        <mxCell id="s1" value="Start&lt;br&gt;npm run dev / start" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="L1"><mxGeometry x="150" y="40" width="170" height="50" as="geometry" /></mxCell>
        <mxCell id="p1" value="Load config (.env)&lt;br&gt;DB_PASSWORD required&lt;br&gt;pg pool (max 20)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="L1"><mxGeometry x="135" y="120" width="200" height="60" as="geometry" /></mxCell>
        <mxCell id="d1" value="KAFKA_ENABLED?&lt;br&gt;(default true)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="L1"><mxGeometry x="145" y="210" width="180" height="90" as="geometry" /></mxCell>
        <mxCell id="p2" value="ensureTopic(ais.raw.messages)&lt;br&gt;start Kafka consumer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="L1"><mxGeometry x="340" y="225" width="165" height="60" as="geometry" /></mxCell>
        <mxCell id="p3" value="Connect WebSocket&lt;br&gt;wss://stream.aisstream.io/v0/stream" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="L1"><mxGeometry x="135" y="330" width="200" height="60" as="geometry" /></mxCell>
        <mxCell id="ext" value="aisstream.io" style="ellipse;shape=cloud;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="L1"><mxGeometry x="380" y="405" width="140" height="80" as="geometry" /></mxCell>
        <mxCell id="p4" value="onopen: send subscription&lt;br&gt;API key · whole-world bbox&lt;br&gt;PositionReport + ShipStaticData&lt;br&gt;ping every 30 s" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="L1"><mxGeometry x="135" y="420" width="200" height="80" as="geometry" /></mxCell>
        <mxCell id="p5" value="onmessage&lt;br&gt;JSON.parse(event.data)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="L1"><mxGeometry x="135" y="530" width="200" height="50" as="geometry" /></mxCell>
        <mxCell id="d2" value="Kafka enabled?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="L1"><mxGeometry x="145" y="610" width="180" height="80" as="geometry" /></mxCell>
        <mxCell id="p7" value="onclose&lt;br&gt;(onerror only logs)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="L1"><mxGeometry x="135" y="760" width="200" height="50" as="geometry" /></mxCell>
        <mxCell id="d3" value="reconnect attempts &amp;lt; 5?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="L1"><mxGeometry x="145" y="840" width="180" height="80" as="geometry" /></mxCell>
        <mxCell id="p8" value="wait 5 s&lt;br&gt;attempts++" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="L1"><mxGeometry x="355" y="855" width="140" height="50" as="geometry" /></mxCell>
        <mxCell id="x1" value="process.exit(1)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="L1"><mxGeometry x="150" y="960" width="170" height="50" as="geometry" /></mxCell>
        <mxCell id="n1" value="attempts reset to 0 on every successful connect" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#f5f5f5;strokeColor=#999999;fontColor=#333333;fontSize=11;" vertex="1" parent="L1"><mxGeometry x="350" y="950" width="150" height="60" as="geometry" /></mxCell>
        <mxCell id="L2" value="2. Kafka queue (kafka.js)" style="swimlane;startSize=30;html=1;fontStyle=1;fontSize=14;fillColor=#f9f9f9;strokeColor=#999999;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="660" y="60" width="340" height="1200" as="geometry" /></mxCell>
        <mxCell id="k1" value="producer.send&lt;br&gt;topic ais.raw.messages&lt;br&gt;key = MMSI, value = raw JSON" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="L2"><mxGeometry x="40" y="615" width="260" height="70" as="geometry" /></mxCell>
        <mxCell id="k2" value="Kafka topic&lt;br&gt;&lt;b&gt;ais.raw.messages&lt;/b&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="L2"><mxGeometry x="75" y="760" width="190" height="90" as="geometry" /></mxCell>
        <mxCell id="k3" value="consumer group maritime-ais-stream-consumers&lt;br&gt;eachMessage: JSON.parse&lt;br&gt;(errors logged, offset still committed)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="L2"><mxGeometry x="40" y="900" width="260" height="80" as="geometry" /></mxCell>
        <mxCell id="k4" value="analytic-service consumes the same topic with its own group → speed + loitering detectors → meta-service /api/anomalies" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#f5f5f5;strokeColor=#999999;fontColor=#333333;fontSize=11;" vertex="1" parent="L2"><mxGeometry x="40" y="1040" width="260" height="80" as="geometry" /></mxCell>
        <mxCell id="L3" value="3. Parse (parser.js)" style="swimlane;startSize=30;html=1;fontStyle=1;fontSize=14;fillColor=#f9f9f9;strokeColor=#999999;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1040" y="60" width="420" height="1200" as="geometry" /></mxCell>
        <mxCell id="q1" value="parseAIS(msg)&lt;br&gt;MetaData: MMSI, ShipName, lat, lon, time_utc → ISO" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="L3"><mxGeometry x="100" y="700" width="220" height="60" as="geometry" /></mxCell>
        <mxCell id="q2" value="MessageType?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="L3"><mxGeometry x="120" y="800" width="180" height="80" as="geometry" /></mxCell>
        <mxCell id="q5" value="dropped&lt;br&gt;(null)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="L3"><mxGeometry x="320" y="815" width="90" height="50" as="geometry" /></mxCell>
        <mxCell id="q3" value="&lt;b&gt;PositionReport&lt;/b&gt;&lt;br&gt;needs MMSI, lat, lon, time (else dropped)&lt;br&gt;→ sog, cog, heading, nav_status" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="L3"><mxGeometry x="10" y="930" width="190" height="90" as="geometry" /></mxCell>
        <mxCell id="q4" value="&lt;b&gt;ShipStaticData&lt;/b&gt;&lt;br&gt;needs MMSI (else dropped)&lt;br&gt;→ name, type, dimensions A–D&lt;br&gt;length = A+B · width = C+D" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="L3"><mxGeometry x="215" y="930" width="195" height="90" as="geometry" /></mxCell>
        <mxCell id="q6" value="parsed message" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="L3"><mxGeometry x="110" y="1110" width="200" height="50" as="geometry" /></mxCell>
        <mxCell id="L4" value="4. Persist (insert.js): one DB transaction per message" style="swimlane;startSize=30;html=1;fontStyle=1;fontSize=14;fillColor=#f9f9f9;strokeColor=#999999;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1500" y="60" width="560" height="1200" as="geometry" /></mxCell>
        <mxCell id="r0" value="processAISMessage(parsed)&lt;br&gt;(no MMSI → skip)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="L4"><mxGeometry x="150" y="50" width="240" height="50" as="geometry" /></mxCell>
        <mxCell id="r1" value="BEGIN (pooled client)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="L4"><mxGeometry x="150" y="130" width="240" height="40" as="geometry" /></mxCell>
        <mxCell id="err" value="Any error → ROLLBACK&lt;br&gt;log; message not stored" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;dashed=1;fontSize=12;" vertex="1" parent="L4"><mxGeometry x="405" y="120" width="145" height="60" as="geometry" /></mxCell>
        <mxCell id="r2" value="SELECT existing ship by MMSI" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="L4"><mxGeometry x="150" y="200" width="240" height="40" as="geometry" /></mxCell>
        <mxCell id="r3" value="Resolve ship type&lt;br&gt;reported 0–99 → use it · invalid → NULL&lt;br&gt;not reported → existing ship's type → else 0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="L4"><mxGeometry x="150" y="270" width="240" height="75" as="geometry" /></mxCell>
        <mxCell id="r4" value="INSERT ship_types (if type not NULL)&lt;br&gt;ON CONFLICT DO NOTHING" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="L4"><mxGeometry x="150" y="375" width="240" height="50" as="geometry" /></mxCell>
        <mxCell id="r5" value="UPSERT ships&lt;br&gt;name / type / dimensions&lt;br&gt;(COALESCE keeps known values)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="L4"><mxGeometry x="150" y="455" width="240" height="60" as="geometry" /></mxCell>
        <mxCell id="d4" value="PositionReport with&lt;br&gt;lat, lon, time?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="L4"><mxGeometry x="170" y="545" width="200" height="90" as="geometry" /></mxCell>
        <mxCell id="d5" value="length &amp;amp; width known?&lt;br&gt;(message or stored&lt;br&gt;ship dimensions)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="L4"><mxGeometry x="160" y="665" width="220" height="110" as="geometry" /></mxCell>
        <mxCell id="r6" value="INSERT ais_positions&lt;br&gt;PostGIS point (lon, lat) · ship_type may be NULL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="L4"><mxGeometry x="150" y="810" width="240" height="60" as="geometry" /></mxCell>
        <mxCell id="r7" value="UPDATE ships latest position&lt;br&gt;(only if newer than last_position_at)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="L4"><mxGeometry x="150" y="900" width="240" height="60" as="geometry" /></mxCell>
        <mxCell id="r8" value="COMMIT&lt;br&gt;stats: ship upserts / positions" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="L4"><mxGeometry x="160" y="990" width="220" height="60" as="geometry" /></mxCell>
        <mxCell id="n2" value="Every 60 s: log&lt;br&gt;&quot;[DB] ✓ Last 60s: N ship upserts, M positions&quot;" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#f5f5f5;strokeColor=#999999;fontColor=#333333;fontSize=11;" vertex="1" parent="L4"><mxGeometry x="410" y="1090" width="140" height="85" as="geometry" /></mxCell>
        <mxCell id="dbn" value="PostgreSQL + PostGIS&lt;br&gt;&lt;b&gt;ais_db&lt;/b&gt;" style="text;html=1;align=center;fontSize=13;" vertex="1" parent="1"><mxGeometry x="2110" y="370" width="190" height="40" as="geometry" /></mxCell>
        <mxCell id="db1" value="&lt;b&gt;ship_types&lt;/b&gt;&lt;br&gt;AIS codes 0–99 (seeded)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="2110" y="420" width="170" height="80" as="geometry" /></mxCell>
        <mxCell id="db2" value="&lt;b&gt;ships&lt;/b&gt;&lt;br&gt;static data + latest position" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="2110" y="520" width="170" height="90" as="geometry" /></mxCell>
        <mxCell id="db3" value="&lt;b&gt;ais_positions&lt;/b&gt;&lt;br&gt;daily partitions + DEFAULT&lt;br&gt;7-day retention (meta-service cron)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="2110" y="850" width="190" height="110" as="geometry" /></mxCell>
        <mxCell id="e46" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s1" target="p1"><mxGeometry relative="1" as="geometry" /></mxCell>
